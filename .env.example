# Optional for Android Expo Go because google-services.json is already used as a fallback.
# Recommended when running the universal/web target: use the Firebase Web App config.
# Firebase Console > Project settings > General > Your apps > Web app (</>)
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_WEB_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=medicq.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=medicq
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=medicq.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=230867590499
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_WEB_APP_ID
