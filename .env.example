# Salin file ini menjadi .env  (file .env tidak ikut di-commit).
# Semua variabel boleh dikosongkan: Firebase otomatis memakai google-services.json.
# Setelah mengubah .env, jalankan ulang:  npx expo start -c

# --- Firebase (disarankan: Web App di Firebase Console -> Project settings -> Your apps -> Web) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- OCR KTP (opsional). Kosong = scan KTP dimatikan, pasien isi data manual ---
EXPO_PUBLIC_KTP_OCR_ENDPOINT=
EXPO_PUBLIC_KTP_OCR_API_KEY=
