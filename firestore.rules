rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    function isStaffOrAdmin() {
      return userRole() == 'staff' || userRole() == 'admin';
    }

    // USERS: patient signup can only create their own patient profile.
    match /users/{userId} {
      allow read: if isSelf(userId) || isStaffOrAdmin();

      allow create: if isSelf(userId)
        && request.resource.data.role == 'patient';

      allow update: if isAdmin()
        || (
          isSelf(userId)
          && request.resource.data.role == resource.data.role
        );

      allow delete: if isAdmin();
    }

    // PATIENT PROFILES
    match /patients/{patientId} {
      allow read: if isSelf(patientId) || isStaffOrAdmin();
      allow create: if isSelf(patientId) || isStaffOrAdmin();
      allow update: if isSelf(patientId) || isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    // REGISTRATIONS
    match /registrations/{registrationId} {
      allow read: if isStaffOrAdmin()
        || (signedIn() && resource.data.patientId == request.auth.uid);

      allow create: if isStaffOrAdmin()
        || (
          signedIn()
          && request.resource.data.patientId == request.auth.uid
          && request.resource.data.status == 'REGISTRATION_PENDING'
        );

      allow update: if isStaffOrAdmin()
        || (
          signedIn()
          && resource.data.patientId == request.auth.uid
          && request.resource.data.patientId == resource.data.patientId
          && request.resource.data.status in ['REGISTRATION_PENDING', 'CANCELLED']
        );

      allow delete: if isAdmin();
    }

    // SERVICE / POLI definitions have no patient-specific private fields.
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // NOTE FOR PRESENTATION: queue queries show queue numbers from the same
    // service to multiple patients, so read is temporarily public in this MVP.
    // Queue documents must not contain NIK, email, or complaint details.
    // For production, move display-safe values to a separate public_queues collection.
    match /queues/{queueId} {
      allow read: if true;
      allow create, update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    match /queue_counters/{counterId} {
      allow read, write: if isStaffOrAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.patientId == request.auth.uid;
      allow create: if isStaffOrAdmin();
      allow update: if signedIn()
        && resource.data.patientId == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
