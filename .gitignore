# ================================
# Node / JavaScript dependencies
# ================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ================================
# Expo / React Native build output
# ================================
.expo/
dist/
web-build/
expo-env.d.ts

# Generated native folders (Expo managed workflow)
# Remove these two lines if you intentionally maintain native projects in Git.
/android/
/ios/

# ================================
# Local environment variables
# Keep the example template, never commit real local .env values.
# ================================
.env
.env.*
!.env.example
!.env.sample

# ================================
# Secrets, private keys, certificates
# ================================
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
*.p8

# Firebase Admin SDK / service-account credentials
serviceAccount*.json
service-account*.json
*service-account*.json
*firebase-adminsdk*.json
firebase-adminsdk-*.json

# Common secret/credential files (only if they contain real credentials)
secrets.json
credentials.json
.env.credentials

# ================================
# Logs and debug output
# ================================
*.log
npm-debug.log*
yarn-debug.log*
expo-debug.log*
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log

# Firebase local cache / emulator runtime data
.firebase/

# ================================
# Operating system / editor files
# ================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# ================================
# Test / coverage / temporary files
# ================================
coverage/
.nyc_output/
*.tmp
*.temp
*.bak

# ================================
# Notes about Firebase client config:
# google-services.json and GoogleService-Info.plist are client configuration,
# not Firebase Admin service-account private keys. They are not ignored here
# by default because some native builds need them. If you intentionally want
# to keep these files out of the repository, uncomment these lines:
# google-services.json
# **/google-services.json
# GoogleService-Info.plist

